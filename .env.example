# Meta Model API key - create one at https://platform.meta.ai
# Used ONLY for voice notes (transcription, netlify/functions/transcribe.js).
# Keep it ONLY here (gitignored) and in Netlify env vars. Never in browser code. Never committed.
META_API_KEY=

# The reading gateway: Muse Spark Open on a Modal shared endpoint
# (OpenAI-compatible /chat/completions). Keys ONLY here (gitignored) and in
# Netlify env vars - never in browser code, never logged, never committed.
# MODEL_NAME must be the EXACT model id: scripts/check-model.js prints the ids
# the endpoint serves (GET /models) so nothing is guessed.
MODEL_BASE_URL=https://inference.us-west.modal.direct/v1
MODEL_API_KEY=
MODEL_NAME=

# Optional, USD per 1M tokens - cost is only ever shown when a real price is
# stated here; without it the app reports n/a instead of inventing one.
# MODEL_PRICE_INPUT=
# MODEL_PRICE_OUTPUT=

# mock = return saved fixtures, no credits used | live = call the gateway
AI_MODE=mock

# Supabase (Stage 2) - from Project Settings > API keys
# SUPABASE_URL         = Project URL (e.g. https://xxxx.supabase.co)
# SUPABASE_PUBLISHABLE = "publishable" / "anon public" key (safe: lives in the app, RLS protects data)
# SUPABASE_SECRET      = "secret" / service_role key (gitignored .env ONLY, never committed, never in chat)
SUPABASE_URL=
SUPABASE_PUBLISHABLE=
SUPABASE_SECRET=

# Overrides (safe defaults already live in netlify/functions/_lib/ai.js - leave commented)
# META_API_BASE_URL=https://api.meta.ai/v1
