# Meta Model API key - create one at https://platform.meta.ai (the docs call it MODEL_API_KEY)
# Keep it ONLY here (gitignored) and in Netlify env vars. Never in browser code. Never committed.
META_API_KEY=

# mock = return saved fixtures, no credits used | live = call Meta Model API
AI_MODE=mock

# Supabase (Stage 2) - from Project Settings > API keys
# SUPABASE_URL         = Project URL (e.g. https://xxxx.supabase.co)
# SUPABASE_PUBLISHABLE = "publishable" / "anon public" key (safe: lives in the app, RLS protects data)
# SUPABASE_SECRET      = "secret" / service_role key (gitignored .env ONLY, never committed, never in chat)
SUPABASE_URL=
SUPABASE_PUBLISHABLE=
SUPABASE_SECRET=

# Overrides (safe defaults already live in netlify/functions/_lib/ai.js - leave commented)
# META_API_BASE_URL=https://api.meta.ai/v1
# META_VISION_MODEL=muse-spark-1.3
